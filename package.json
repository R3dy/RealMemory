{
  "name": "realmemory",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "An OpenCode plugin that gives AI agents real persistent memory — a weighted, indexed database that stores what agents learn across sessions and recalls it automatically.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "agent-memory",
    "persistent-memory",
    "mcp",
    "vector-search",
    "semantic-search",
    "ai-agent",
    "knowledge-graph"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/R3dy/RealMemory.git"
  },
  "homepage": "https://github.com/R3dy/RealMemory",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "realmemory-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  }
}
